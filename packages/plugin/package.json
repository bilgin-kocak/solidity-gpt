{
  "name": "@soliditygpt/hardhat-plugin",
  "version": "0.1.0",
  "description": "AI-powered test generator for Hardhat 3",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./validators/testValidator": {
      "types": "./dist/validators/testValidator.d.ts",
      "import": "./dist/validators/testValidator.js",
      "default": "./dist/validators/testValidator.js"
    },
    "./utils/compiler": {
      "types": "./dist/utils/compiler.d.ts",
      "import": "./dist/utils/compiler.js",
      "default": "./dist/utils/compiler.js"
    },
    "./generator/refiner": {
      "types": "./dist/generator/refiner.d.ts",
      "import": "./dist/generator/refiner.js",
      "default": "./dist/generator/refiner.js"
    },
    "./generator/parser": {
      "types": "./dist/generator/parser.d.ts",
      "import": "./dist/generator/parser.js",
      "default": "./dist/generator/parser.js"
    },
    "./generator/analyzer": {
      "types": "./dist/generator/analyzer.d.ts",
      "import": "./dist/generator/analyzer.js",
      "default": "./dist/generator/analyzer.js"
    },
    "./generator/promptBuilder": {
      "types": "./dist/generator/promptBuilder.d.ts",
      "import": "./dist/generator/promptBuilder.js",
      "default": "./dist/generator/promptBuilder.js"
    },
    "./generator/aiService": {
      "types": "./dist/generator/aiService.d.ts",
      "import": "./dist/generator/aiService.js",
      "default": "./dist/generator/aiService.js"
    },
    "./generator/writer": {
      "types": "./dist/generator/writer.d.ts",
      "import": "./dist/generator/writer.js",
      "default": "./dist/generator/writer.js"
    },
    "./tasks/generate-tests": {
      "types": "./dist/tasks/generate-tests.d.ts",
      "import": "./dist/tasks/generate-tests.js",
      "default": "./dist/tasks/generate-tests.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsc --build --watch",
    "test": "echo \"Tests coming soon\""
  },
  "keywords": [
    "hardhat",
    "hardhat-plugin",
    "solidity",
    "testing",
    "ai",
    "gpt",
    "claude"
  ],
  "license": "MIT",
  "peerDependencies": {
    "hardhat": "^3.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@solidity-parser/parser": "^0.18.0",
    "chalk": "^5.3.0",
    "openai": "^4.0.0",
    "ora": "^7.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "hardhat": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
